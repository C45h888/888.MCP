# MCP Server Configuration
# Copy this file to .env and fill in your actual values

# MCP Server URL (Render deployment)
MCP_URL="https://mcp-server-xxxx.onrender.com"

# MCP API Key (generate a secure random string)
MCP_API_KEY="your-api-key-here"

# AWS Credentials (IAM user for S3 access)
AWS_KEY_ID="AKIAXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# S3 Data Bucket
S3_DATA_BUCKET="your-bucket-name"

# AWS Region (optional, default: eu-north-1)
AWS_DEFAULT_REGION="eu-north-1"
