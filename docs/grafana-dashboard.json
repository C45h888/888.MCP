{
  "dashboard": {
    "title": "MCP Server - Production Monitoring",
    "tags": ["mcp", "trading", "production"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Publish Rate (messages/sec)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(mcp_publish_total[1m])",
            "legendFormat": "{{channel}}",
            "refId": "A"
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "yaxes": [
          {"label": "msg/sec", "format": "short"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Publish Latency P95 (seconds)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(mcp_publish_latency_seconds_bucket[1m]))",
            "legendFormat": "{{channel}}",
            "refId": "A"
          }
        ],
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "yaxes": [
          {"label": "seconds", "format": "s"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [1], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "High Latency Alert",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 3,
        "title": "Redis Connection Status",
        "type": "stat",
        "targets": [
          {
            "expr": "mcp_redis_connected",
            "refId": "A"
          }
        ],
        "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "reduceOptions": {
            "values": false,
            "calcs": ["last"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "Disconnected", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "Connected", "color": "green"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Kill-Switch Status",
        "type": "stat",
        "targets": [
          {
            "expr": "mcp_kill_switch_active",
            "refId": "A"
          }
        ],
        "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4},
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "reduceOptions": {
            "values": false,
            "calcs": ["last"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "Normal", "color": "green"}}},
              {"type": "value", "options": {"1": {"text": "HALTED", "color": "red"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Archiver Queue Depth",
        "type": "graph",
        "targets": [
          {
            "expr": "mcp_archive_queue_size",
            "legendFormat": "{{channel}}",
            "refId": "A"
          }
        ],
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "yaxes": [
          {"label": "messages", "format": "short"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [100], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "name": "High Queue Depth Alert"
        }
      },
      {
        "id": 6,
        "title": "Validation Success Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(mcp_validation_success_total[1m]) / (rate(mcp_validation_success_total[1m]) + rate(mcp_validation_failures_total[1m]))",
            "legendFormat": "{{channel}}",
            "refId": "A"
          }
        ],
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "yaxes": [
          {"label": "success rate", "format": "percentunit", "min": 0, "max": 1},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Total Messages Published",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(mcp_publish_total)",
            "refId": "A"
          }
        ],
        "gridPos": {"x": 12, "y": 12, "w": 6, "h": 4},
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "values": false,
            "calcs": ["last"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "blue"}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "S3 Upload Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(mcp_archive_flush_total[5m]) / (rate(mcp_archive_flush_total[5m]) + rate(mcp_archive_upload_failures_total[5m]))",
            "refId": "A"
          }
        ],
        "gridPos": {"x": 18, "y": 12, "w": 6, "h": 4},
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "reduceOptions": {
            "values": false,
            "calcs": ["last"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.9, "color": "yellow"},
                {"value": 0.95, "color": "green"}
              ]
            }
          }
        }
      }
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    }
  }
}
