# smoke_test.config - Configuration Template for MCP Smoke Tests
#
# Copy this file and fill in your actual values:
#   cp smoke_test.config smoke_test.local.config
#   # Edit smoke_test.local.config with your values
#   source smoke_test.local.config
#   ./scripts/run_smoke_tests.sh
#
# NOTE: smoke_test.local.config should be added to .gitignore to avoid
# committing secrets to version control.

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# MCP Server URL (your Render web service URL)
# Example: https://mcp-server-abc123.onrender.com
export MCP_URL="https://mcp-server-7h8i.onrender.com"

# MCP API Key (from Render environment variables)
# This is the value of MCP_API_KEY in your Render web service config
export MCP_API_KEY="92a746171ea6a580f8b29bf31dfe0b0c"

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# S3 Bucket (optional - only if S3 retrieval is configured)
# export S3_BUCKET="your-s3-bucket-name"

# AWS Region (optional - only needed if S3 is configured)
# export AWS_REGION="us-west-2"

# Enable verbose output (shows full curl responses)
# export VERBOSE="true"

# Archiver wait time in seconds (default: 90)
# How long to wait for archiver to flush messages
# export ARCHIVER_WAIT_TIME="90"

# ============================================================================
# RENDER SERVICE NAMES (if different from defaults)
# ============================================================================

# Web service name in Render (default: mcp-server)
# export WEB_SERVICE="mcp-server"

# Worker service name in Render (default: mcp-archiver)
# export WORKER_SERVICE="mcp-archiver"

# Redis service name in Render (default: mcp-redis)
# export REDIS_SERVICE="mcp-redis"

# ============================================================================
# EXAMPLE USAGE
# ============================================================================

# 1. Get your values from Render dashboard:
#    - Go to your mcp-server service
#    - Copy the service URL
#    - Go to Environment tab
#    - Copy the MCP_API_KEY value

# 2. Create local config:
#    cp smoke_test.config smoke_test.local.config

# 3. Edit smoke_test.local.config:
#    export MCP_URL="https://mcp-server-abc123.onrender.com"
#    export MCP_API_KEY="your-actual-key-here"

# 4. Run tests:
#    source smoke_test.local.config
#    cd mcp && ./scripts/run_smoke_tests.sh

# ============================================================================
# SECURITY NOTES
# ============================================================================

# - NEVER commit smoke_test.local.config to git
# - Add it to .gitignore:
#   echo "smoke_test.local.config" >> .gitignore
# - Use environment variables in CI/CD instead:
#   GitHub Actions: Use secrets
#   Render: Use environment variables
#
# Example GitHub Actions usage:
#   env:
#     MCP_URL: ${{ secrets.MCP_URL }}
#     MCP_API_KEY: ${{ secrets.MCP_API_KEY }}
