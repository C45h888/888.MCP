{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Market Data Schema",
  "description": "Published by Feeder. Subscribed by Brain. Contains price and volume data for trading pairs.",
  "properties": {
    "timestamp": {
      "type": "integer",
      "description": "Unix timestamp in seconds"
    },
    "pair": {
      "type": "string",
      "description": "Trading pair identifier (e.g., BTC-ETH)",
      "pattern": "^[A-Z]+-[A-Z]+$"
    },
    "price_btc": {
      "type": "number",
      "description": "Bitcoin price in USD",
      "minimum": 0
    },
    "price_eth": {
      "type": "number",
      "description": "Ethereum price in USD",
      "minimum": 0
    },
    "volume_btc": {
      "type": "number",
      "description": "Bitcoin trading volume",
      "minimum": 0
    }
  },
  "required": ["timestamp", "pair", "price_btc", "price_eth", "volume_btc"],
  "additionalProperties": false
}
